# ==========================================
# Backend Service Configuration (Node.js Express)
# ==========================================
PORT=5000
PYTHON_SERVICE_URL=http://localhost:8000

# Firebase Configuration Option 1: Path to Firebase Service Account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./backend/serviceAccountKey.json

# Firebase Configuration Option 2: Direct environment variables (Render / Cloud platforms)
# FIREBASE_PROJECT_ID=smart-surplus-food-recovery
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@smart-surplus-food-recovery.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:5000
