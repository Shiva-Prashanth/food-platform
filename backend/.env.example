# ==========================================
# Backend Service Configuration
# ==========================================
PORT=5000
PYTHON_SERVICE_URL=http://localhost:8000

# Firebase Configuration Option 1: Service Account JSON file path (Recommended for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Firebase Configuration Option 2: Individual environment variables (Used in deployment platforms like Render)
# FIREBASE_PROJECT_ID=smart-surplus-food-recovery
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@smart-surplus-food-recovery.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
